{
  "name": "prayer-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build && node scripts/verify-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "package": "python3 scripts/package.py"
  },
  "engines": { "node": ">=22.12.0" },
  "dependencies": { "vue": "^3.5.0", "dexie": "^4.0.11" },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.0.0",
    "typescript": "~5.9.0",
    "vue-tsc": "^3.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.0",
    "fake-indexeddb": "^6.0.0",
    "@playwright/test": "^1.55.0"
  }
}
